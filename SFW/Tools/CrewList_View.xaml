<Window x:Class="SFW.Tools.CrewList_View"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SFW.Tools"
        xmlns:cvtr="clr-namespace:SFW.Converters"
        x:Name="CrewMgt_Window"
        Title="Crew Labor Allocation" MinHeight="440" Width="1000" WindowStyle="ToolWindow" WindowStartupLocation="CenterScreen" Topmost="True">

    <Window.Resources>
        <cvtr:BoolToVisibility x:Key="BoolToVisConverter" />
        <cvtr:IntToVisibility x:Key="IntToVisConverter"/>
        <cvtr:BoolInverter x:Key="BoolInverterConverter"/>
    </Window.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="35" />
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>

        <TextBlock Grid.RowSpan="2"
                   Text="No data to display."
                   Foreground="Crimson"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="30"
                   Visibility="{Binding NoData, Converter={StaticResource BoolToVisConverter}}"/>

        <!--#region Crew Header-->

        <Rectangle Grid.Row="0"
                   Fill="#FF135185"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"/>
        <TextBlock Grid.Row="0"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Text="Crew Members"
                   FontWeight="Bold"
                   FontSize="20"
                   Foreground="WhiteSmoke"/>
        <DatePicker Grid.Row="0"
                    FontSize="18"
                    FontWeight="Bold"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    SelectedDate="{Binding SelectedDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

        <!--#endregion-->

        <!--#region Crew Inputs-->

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">

            <ItemsControl Name="CrewMembers"
                          ItemsSource="{Binding Path=CrewCollection}"
                          Margin="10,0,0,0"
                          FontSize="18"
                          Cursor="Hand"
                          Background="Transparent"
                          Foreground="Black"
                          Focusable="False">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel IsItemsHost="True"
                                                Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>

                        <StackPanel Orientation="Vertical"
                                    Margin="5">
                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="300"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="200"/>
                                </Grid.ColumnDefinitions>

                                <Image Grid.Column="0"
                                       Source="/SFW;component/Icons/First.ico"
                                       Visibility="{Binding Shift, Converter={StaticResource IntToVisConverter}, ConverterParameter=L1}"/>
                                <Image Grid.Column="0"
                                       Source="/SFW;component/Icons/Second.ico"
                                       Visibility="{Binding Shift, Converter={StaticResource IntToVisConverter}, ConverterParameter=L2}"/>
                                <Image Grid.Column="0"
                                       Source="/SFW;component/Icons/Third.ico"
                                       Visibility="{Binding Shift, Converter={StaticResource IntToVisConverter}, ConverterParameter=L3}"/>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding IdNumber}"
                                           Margin="10,0,0,0"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="2"
                                           Text="{Binding Name}"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>

                                <CheckBox Grid.Column="3"
                                          x:Name="IsWorking"
                                          IsChecked="{Binding IsWorking, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Content="Is Working"
                                          FontSize="18"
                                          FontWeight="Bold"
                                          IsTabStop="False"
                                          IsEnabled="{Binding DataContext.CanEdit, ElementName=CrewMgt_Window}"
                                          VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="5"
                                           Text="Hours:"
                                           FontWeight="Bold"
                                           Foreground="#FF135185"
                                           TextDecorations="Underline"
                                           VerticalAlignment="Center">
                                    <TextBlock.Visibility>
                                        <MultiBinding Converter="{StaticResource BoolToVisConverter}">
                                            <Binding Path="IsWorking"/>
                                            <Binding Path="DataContext.CanEdit" ElementName="CrewMgt_Window"/>
                                        </MultiBinding>
                                    </TextBlock.Visibility>
                                </TextBlock>

                                <TextBlock Grid.Column="6"
                                           Text="{Binding HoursWorked}"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center">
                                    <TextBlock.Visibility>
                                        <MultiBinding Converter="{StaticResource BoolToVisConverter}">
                                            <Binding Path="IsWorking"/>
                                            <Binding Path="DataContext.CanEdit" ElementName="CrewMgt_Window" Converter="{StaticResource BoolInverterConverter}"/>
                                        </MultiBinding>
                                    </TextBlock.Visibility>
                                </TextBlock>

                                <TextBox Grid.Column="6"
                                         Text="{Binding HoursWorked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="2"
                                         Background="LightGray"
                                         VerticalAlignment="Center"
                                         Style="{DynamicResource RequiredTextBox}">
                                    <TextBox.Visibility>
                                        <MultiBinding Converter="{StaticResource BoolToVisConverter}">
                                            <Binding Path="IsWorking"/>
                                            <Binding Path="DataContext.CanEdit" ElementName="CrewMgt_Window"/>
                                        </MultiBinding>
                                    </TextBox.Visibility>
                                </TextBox>

                                <TextBlock Grid.Column="7"
                                           Text="{Binding WorkCenter.MachineName}"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center">
                                    <TextBlock.Visibility>
                                        <MultiBinding Converter="{StaticResource BoolToVisConverter}">
                                            <Binding Path="IsWorking"/>
                                            <Binding Path="DataContext.CanEdit" ElementName="CrewMgt_Window" Converter="{StaticResource BoolInverterConverter}" ConverterParameter="i"/>
                                        </MultiBinding>
                                    </TextBlock.Visibility>
                                </TextBlock>

                                <ComboBox x:Name="WorkMachine"
                                          Grid.Column="7"
                                          ItemsSource="{Binding DataContext.MachineCollection, ElementName=CrewMgt_Window}"
                                          SelectedValue="{Binding WorkCenter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          DisplayMemberPath="MachineName"
                                          FontSize="18"
                                          FontWeight="Bold"
                                          Background="LightGray"
                                          Width="150"
                                          TabIndex="5"
                                          Margin="5,0,0,0"
                                          Style="{DynamicResource OptionalComboBox}">
                                    <ComboBox.Visibility>
                                        <MultiBinding Converter="{StaticResource BoolToVisConverter}">
                                            <Binding Path="IsWorking"/>
                                            <Binding Path="DataContext.CanEdit" ElementName="CrewMgt_Window"/>
                                        </MultiBinding>
                                    </ComboBox.Visibility>
                                </ComboBox>

                            </Grid>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </ScrollViewer>

        <!--#endregion-->
        
        <!--#region Cew Submissions-->

        <TextBlock Grid.Row="2"
                   Margin="10,0,0,0"
                   VerticalAlignment="Center"
                   Text="Published"
                   Visibility="{Binding Published, Converter={StaticResource BoolToVisConverter}}"
                   Foreground="Crimson"
                   FontWeight="Bold"
                   FontSize="18" />

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Visibility="{Binding CanView, Converter={StaticResource BoolToVisConverter}}">

            <Button Grid.Row="2"
                    Width="40"
                    Margin="5"
                    Content="1"
                    FontSize="18"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    Command="{Binding ShiftViewICommand}"
                    CommandParameter="1"
                    Style="{DynamicResource DefaultButton}"/>

            <Button Grid.Row="2"
                    Width="40"
                    Margin="5"
                    Content="2"
                    FontSize="18"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    Command="{Binding ShiftViewICommand}"
                    CommandParameter="2"
                    Style="{DynamicResource DefaultButton}"/>

            <Button Grid.Row="2"
                    Width="40"
                    Margin="5"
                    Content="3"
                    FontSize="18"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    Command="{Binding ShiftViewICommand}"
                    CommandParameter="3"
                    Style="{DynamicResource DefaultButton}"/>

        </StackPanel>
        

        <Button Grid.Row="2"
                Content="Publish"
                Width="100"
                FontSize="18"
                Margin="5,5,10,5"
                VerticalAlignment="Center"
                HorizontalAlignment="Right"
                Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisConverter}}"
                Command="{Binding SubmitICommand}"
                Style="{DynamicResource DefaultButton}" />

        <!--#endregion-->

    </Grid>
</Window>
