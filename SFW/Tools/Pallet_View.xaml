<Window x:Class="SFW.Tools.Pallet_View"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SFW.Tools"
        xmlns:cvtr="clr-namespace:SFW.Converters"
        x:Name="PalletMgt_Window"
        Title="Pallet Management" MinHeight="440" MinWidth="955" WindowStyle="ToolWindow" WindowStartupLocation="CenterScreen" Topmost="True">

    <Window.Resources>
        <cvtr:BoolToVisibility x:Key="BoolToVisConverter" />
        <cvtr:IntToVisibility x:Key="IntToVisConverter"/>
        <cvtr:BoolInverter x:Key="BoolInverterConverter"/>
    </Window.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="35" />
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>

        <!--#region Window Header-->

        <Rectangle Grid.Row="0"
                   Fill="#FF135185"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"/>
        <TextBlock Grid.Row="0"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Text="Container Pallet Information"
                   FontWeight="Bold"
                   FontSize="20"
                   Foreground="WhiteSmoke"/>

        <!--#endregion-->

        <!--#region Window Data-->

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding PalletTable, NotifyOnSourceUpdated=True, Mode=TwoWay}"
                  CanUserSortColumns="True"
                  CanUserAddRows="True"
                  CanUserDeleteRows="True"
                  VerticalAlignment="Top"
                  HorizontalAlignment="Left"
                  AlternationCount="1"
                  AutoGenerateColumns="True"
                  AlternatingRowBackground="LightGray"
                  FontSize="18"
                  FontWeight="Bold"
                  ColumnHeaderStyle="{DynamicResource ModernColumnHeader}"/>

        <!--#endregion-->
        
        <!--#region Window Submissions-->

        <Button Grid.Row="2"
                Content="Save"
                Width="100"
                FontSize="18"
                Margin="5,5,10,5"
                VerticalAlignment="Center"
                HorizontalAlignment="Right"
                Command="{Binding SaveICommand}"
                Style="{DynamicResource DefaultButton}" />

        <!--#endregion-->

    </Grid>
</Window>
