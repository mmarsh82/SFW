<Window x:Class="SFW.Tools.ErpUpload_View"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SFW.Tools"
        xmlns:cvtr="clr-namespace:SFW.Converters"
        xmlns:main="clr-namespace:SFW"
        x:Name="ErpUpload_Window"
        Title="Upload Excel data to ERP" WindowStyle="ToolWindow" Height="300" Width="700" Topmost="True">

    <Window.Resources>

        <cvtr:BoolToVisibility x:Key="BooltoVisConverter"/>

    </Window.Resources>

    <Grid>

        <StackPanel Grid.ColumnSpan="2" Grid.RowSpan="5"
                    Orientation="Vertical"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Visibility="{Binding Submitted, Converter={StaticResource BooltoVisConverter}}">

            <TextBlock Text="Uploading Changes"
                       FontWeight="Bold"
                       Opacity="80"
                       FontSize="50"/>

            <Control Background="Transparent"
                     Style="{DynamicResource BusyAnimationStyle}" />

        </StackPanel>

        <Grid Visibility="{Binding Submitted, Converter={StaticResource BooltoVisConverter}, ConverterParameter=i}">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.ColumnSpan="2" Grid.Row="0"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Text="                                       ** DISCLAIMER **&#x0a;Excel file must contain 2 columns, the table ID and the new value."
                   FontSize="20"
                   Foreground="Crimson"
                   FontWeight="Bold"/>

            <TextBlock Grid.Column="0" Grid.Row="1"
                   Text="Table Name:"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   FontSize="18"
                   FontWeight="Bold"
                   TextDecorations="Underline"/>

            <TextBox Grid.Column="1" Grid.Row="1"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Center"
                 FontSize="18"
                 Margin="5"
                 MinWidth="100"
                 Background="LightGray"
                 Text="{Binding ErpTableName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Column="0" Grid.Row="2"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Text="Attribute Number:"
                   FontSize="18"
                   FontWeight="Bold"
                   TextDecorations="Underline"/>

            <TextBox Grid.Column="1" Grid.Row="2"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Center"
                 FontSize="18"
                 Margin="5"
                 MinWidth="100"
                 Background="LightGray"
                 Text="{Binding AttributeNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            <Button Grid.Column="0"  Grid.Row="3"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Visibility="{Binding ValidFile, Converter={StaticResource BooltoVisConverter}, ConverterParameter=i}"
                Content="Select File"
                Margin="3"
                Width="120"
                FontSize="18"
                Command="{Binding SelectFileICommand}"
                Style="{DynamicResource DefaultButton}"/>

            <StackPanel Orientation="Horizontal"
                    Grid.Column="0" Grid.Row="3"
                    HorizontalAlignment="Right"
                    Visibility="{Binding ValidFile, Converter={StaticResource BooltoVisConverter}}">

                <Button Command="{Binding SelectFileICommand}"
                    Background="Transparent"
                    BorderThickness="0"
                    Margin="5"
                    Style="{DynamicResource DefaultButton}">
                    <Button.Content>
                        <Image Source="/SFW;component/Icons/Refresh.ico" />
                    </Button.Content>
                </Button>

                <TextBlock VerticalAlignment="Center"
                       Text="File Path:"
                       FontSize="18"
                       FontWeight="Bold"
                       TextDecorations="Underline"/>

            </StackPanel>

            <TextBlock Grid.Column="1" Grid.Row="3"
                   Margin="5,0,0,0"
                   Visibility="{Binding ValidFile, Converter={StaticResource BooltoVisConverter}}"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   Text="{Binding UploadFilePath}"
                   FontSize="18"
                   FontStyle="Italic"/>

            <TextBlock Grid.ColumnSpan="2" Grid.Row="4"
                       Margin="20,0,0,5"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Bottom"
                       Text="{Binding ErpLibrary}"
                       FontSize="18"
                       FontStyle="Italic"/>

            <Button Grid.ColumnSpan="2" Grid.Row="4"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Content="Upload"
                    Margin="5,5,50,5"
                    Width="100"
                    FontSize="18"
                    Command="{Binding SubmitICommand}"
                    Style="{DynamicResource DefaultButton}"/>

        </Grid>
    </Grid>
</Window>
