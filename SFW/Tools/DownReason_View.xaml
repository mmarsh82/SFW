<Window x:Class="SFW.Tools.DownReason_View"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SFW.Tools"
        x:Name="Diamond_Window"
        Title="Workcenter Down" Height="150" Width="500" WindowStyle="ToolWindow" Topmost="True">
    <Grid Background="LightGray">

        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left">

            <TextBlock Text="Down Reason:"
                       FontSize="18"
                       FontWeight="Bold"
                       TextDecorations="Underline"
                       Foreground="#FF135185"/>

            <ComboBox ItemsSource="{Binding DownReasonList, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      SelectedValue="{Binding SelectedReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      DisplayMemberPath="Value"
                      FontSize="18"
                      FontWeight="Bold"
                      Background="LightGray"
                      IsEditable="True"
                      Width="Auto"
                      MinWidth="150"
                      Margin="2"
                      Style="{DynamicResource RequiredComboBox}"/>

        </StackPanel>

        <TextBlock Grid.Row="1"
                   Text="Note:"
                   FontSize="18"
                   FontWeight="Bold"
                   TextDecorations="Underline"
                   Foreground="#FF135185"/>

        <TextBox Grid.Row="2"
                 Text="{Binding UserNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 MinWidth="300"
                 MaxWidth="580"
                 MaxLength="500"
                 Background="LightGray"
                 HorizontalAlignment="Left"
                 FontSize="20"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 TabIndex="8"
                 SpellCheck.IsEnabled="True"
                 SpellCheck.SpellingReform="PreAndPostreform"
                 TextWrapping="WrapWithOverflow"
                 Margin="5,0,5,0"
                 Style="{StaticResource OptionalTextBox}"/>

        <Button Grid.Row="3"
                Content="Submit"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="1,1,10,1"
                Width="100"
                FontSize="18"
                Command="{Binding SubmitICommand}"
                Style="{DynamicResource DefaultButton}"/>

    </Grid>
</Window>
