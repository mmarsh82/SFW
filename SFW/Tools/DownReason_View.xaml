<Window x:Class="SFW.Tools.DownReason_View"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SFW.Tools"
        xmlns:cvtr="clr-namespace:SFW.Converters"
        x:Name="QueState_Window"
        Title="Workcenter Down" Height="300" Width="650" WindowStyle="ToolWindow" Topmost="True" ResizeMode="NoResize">

    <Window.Resources>
        <cvtr:BoolToVisibility x:Key="BoolToVisConverter"/>
    </Window.Resources>
    
    <Grid Background="LightGray">

        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="150"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left">

            <TextBlock Text="Down Reason:"
                       FontSize="18"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       TextDecorations="Underline"
                       Margin="10,0,0,0"
                       Foreground="#FF135185"/>

            <ComboBox ItemsSource="{Binding DownReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      SelectedValue="{Binding SelectedReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      DisplayMemberPath="Value"
                      FontSize="18"
                      FontWeight="Bold"
                      Background="LightGray"
                      IsEditable="True"
                      Width="Auto"
                      MinWidth="200"
                      Margin="2"
                      Style="{DynamicResource RequiredComboBox}"/>

            <TextBlock Text="Reference:"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="15,0,0,0"
                       VerticalAlignment="Center"
                       TextDecorations="Underline"
                       Visibility="{Binding NeedReference, Converter={StaticResource BoolToVisConverter}}"
                       Foreground="#FF135185"/>

            <TextBox Text="{Binding Reference, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Visibility="{Binding NeedReference, Converter={StaticResource BoolToVisConverter}}"
                     FontSize="18"
                     FontWeight="Bold"
                     Background="WhiteSmoke"
                     Margin="2"
                     Width="100"
                     MaxLength="7"
                     CharacterCasing="Upper"
                     Style="{DynamicResource RequiredTextBox}" />

        </StackPanel>

        <TextBlock Grid.Row="1"
                   Text="Note:"
                   FontSize="18"
                   Margin="10,0,0,0"
                   FontWeight="Bold"
                   TextDecorations="Underline"
                   Foreground="#FF135185"/>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      Height="150">
            
            <TextBox Text="{Binding UserNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     MinWidth="400"
                     MaxWidth="680"
                     MaxLength="500"
                     Background="WhiteSmoke"
                     HorizontalAlignment="Left"
                     FontSize="20"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     SpellCheck.IsEnabled="True"
                     SpellCheck.SpellingReform="PreAndPostreform"
                     TextWrapping="WrapWithOverflow"
                     Margin="10,0,10,0"
                     Style="{StaticResource OptionalTextBox}"/>
            
        </ScrollViewer>

        <Button Grid.Row="3"
                Content="Submit"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="1,1,10,1"
                Width="100"
                FontSize="18"
                Command="{Binding SubmitICommand}"
                Style="{DynamicResource DefaultButton}"/>

    </Grid>
</Window>
