<Window x:Class="SFW.UserLogIn.View"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SFW.UserLogIn"
        xmlns:cvtr="clr-namespace:SFW.Converters"
        x:Name="LogIn_Window"
        SizeToContent="WidthAndHeight" WindowStyle="ToolWindow" ResizeMode="NoResize" Icon="/SFW;component/Icons/Admin.ico" WindowStartupLocation="CenterScreen" Background="LightGray">
    <Window.Style>
        <Style TargetType="{x:Type Window}">
            <Setter Property="Title" Value="User Log In"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ViewType}" Value="True">
                    <Setter Property="Title" Value="Password Reset"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Style>


    <Window.Resources>
        <cvtr:PasswordConcat x:Key="PasswordConcat"/>
        <cvtr:BoolToVisibility x:Key="BoolToVisConverter"/>
        <cvtr:StringToVisibility x:Key="StringToVisConverter"/>
    </Window.Resources>
    
    <Window.InputBindings>
        <KeyBinding Gesture="Enter" Command="{Binding LogInCommand}">
            <KeyBinding.CommandParameter>
                <MultiBinding Converter="{StaticResource PasswordConcat}">
                    <Binding ElementName="oldPwdBox"/>
                    <Binding ElementName="newPwdBox"/>
                    <Binding ElementName="confirmPwdBox"/>
                </MultiBinding>
            </KeyBinding.CommandParameter> 
            </KeyBinding>
    </Window.InputBindings>

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--#region User Name -->
        
        <Image Grid.Column="0"
               Source="/SFW;component/Icons/Warning.ico"
               Width="30"
               Height="30"
               Visibility="{Binding Text.Length, ElementName=UserName, Converter={StaticResource BoolToVisConverter}, ConverterParameter=i}"/>

        <TextBlock Grid.Column="1" Grid.Row="0"
                   VerticalAlignment="Center"
                   Text="User Name:"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="#FF135185"/>

        <TextBox x:Name="UserName"
                 Grid.Column="2" Grid.Row="0"
                 Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                 Margin="5"
                 Width="275"
                 FontSize="22"
                 FontWeight="Bold"/>
        
        <!--#endregion-->
        
        <!--#region Password -->

        <TextBlock Grid.Column="1" Grid.Row="1"
                   VerticalAlignment="Center"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="#FF135185">
            <TextBlock.Style>
                <Style TargetType="{x:Type TextBlock}">
                    <Setter Property="Text" Value="Password:"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ViewType}" Value="True">
                            <Setter Property="Text" Value="Old Password:"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        
        <PasswordBox x:Name="oldPwdBox"
                     Grid.Column="2" Grid.Row="1"
                     Margin="5"
                     Width="275"
                     FontSize="22"
                     FontWeight="Bold"/>
        
        <!--#endregion-->
        
        <!--#region New Password -->
        
        <TextBlock Grid.Column="1" Grid.Row="2"
                   VerticalAlignment="Center"
                   Text="New Password:"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="#FF135185"
                   Visibility="{Binding ViewType, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"/>
        
        <PasswordBox x:Name="newPwdBox" Grid.Column="2" Grid.Row="2"
                     Margin="5"
                     Width="275"
                     FontSize="22"
                     FontWeight="Bold"
                     Visibility="{Binding ViewType, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"/>
        
        <!--#endregion-->
        
        <!--#region Password Confirmation -->
        
        <TextBlock Grid.Column="1" Grid.Row="3"
                   VerticalAlignment="Center"
                   Text="Confirm Password:"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="#FF135185"
                   Visibility="{Binding ViewType, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"/>
        
        <PasswordBox x:Name="confirmPwdBox" Grid.Column="2" Grid.Row="3"
                     Margin="5"
                     Width="275"
                     FontSize="22"
                     FontWeight="Bold"
                     Visibility="{Binding ViewType, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"/>
        
        <!--#endregion-->

        <Control Grid.ColumnSpan="3" Grid.Row="4" Grid.RowSpan="2"
                 Background="Transparent"
                 VerticalAlignment="Center"
                 HorizontalAlignment="Center"
                 Visibility="{Binding LogInThreadIsWorking, Converter={StaticResource BoolToVisConverter}}"
                 Style="{DynamicResource BusyAnimationStyle}" />

        <!--#region Submission -->
        
        <Button Grid.ColumnSpan="3" Grid.Row="4"
                Name="submitButton"
                Command="{Binding LogInCommand}"
                Margin="5"
                Content="Submit"
                Width="100"
                FontSize="16"
                Visibility="{Binding LogInThreadIsWorking, Converter={StaticResource BoolToVisConverter}, ConverterParameter=i}"
                Style="{DynamicResource DefaultButton}">
            <Button.CommandParameter>
                <MultiBinding Converter="{StaticResource PasswordConcat}">
                    <Binding ElementName="oldPwdBox"/>
                    <Binding ElementName="newPwdBox"/>
                    <Binding ElementName="confirmPwdBox"/>
                </MultiBinding>
            </Button.CommandParameter>
        </Button>
        
        <!--#endregion-->
        
        <!--#region Error message -->

        <TextBlock Grid.ColumnSpan="3" Grid.Row="5"
                   Text="{Binding Error, Mode=OneWay}"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="Crimson"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"
                   Visibility="{Binding Error, Mode=OneWay, Converter={StaticResource StringToVisConverter}}"/>
        
        <!--#endregion-->

    </Grid>
</Window>
