<UserControl x:Class="SFW.QMS.Notice.View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
             xmlns:bhvr="clr-namespace:SFW.Behaviors"
             xmlns:cmd="clr-namespace:SFW.Commands"
             xmlns:cvtr="clr-namespace:SFW.Converters"
             xmlns:local="clr-namespace:SFW.QMS.Notice"
             xmlns:main="clr-namespace:SFW"
             x:Name="NcrNoticeUC">

    <UserControl.Resources>

        <cmd:ViewLoad x:Key="ViewLoadCommand" />
        <cmd:PartSearch x:Key="PartSearchCommand"/>
        <cvtr:BoolToVisibility x:Key="BoolToVisConverter"/>
        <cvtr:SkuMasterPrint x:Key="PartSearchConverter"/>
        <cvtr:DateToVisibility x:Key="DateToVisConverter"/>
        <cvtr:Multi_EqualIntToVisibility x:Key="IntEqualConverter"/>
        <cvtr:IntToVisibility x:Key="IntToVisConverter" />
        <cvtr:StringToVisibility x:Key="StringToVisConverter"/>
        <cvtr:BoolToBackgroundColor x:Key="BoolToBGConverter"/>
        <cvtr:IntToBool x:Key="IntToBoolConverter"/>

    </UserControl.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--#region Grid.Row 0 Notice Header-->

        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left">

                <Button Background="Transparent"
                        BorderThickness="0"
                        Command="{StaticResource ViewLoadCommand}"
                        CommandParameter="-1">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/SFW;component/Icons/BackArrow.ico" />
                            <TextBlock Text="Back"
                                       VerticalAlignment="Center"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="Crimson" />
                        </StackPanel>
                    </Button.Content>
                </Button>

                <TextBlock Text="Search:"
                           FontSize="18"
                           FontWeight="Bold"
                           TextDecorations="Underline"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center" />

                <TextBox x:Name="SearchTextBox"
                         Text="{Binding SearchFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Width="200"
                         FontSize="18"
                         Margin="5"
                         Background="LightGray" />

            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Command="{Binding ExportQmsICommand}"
                        Margin="5,5,20,5"
                        BorderThickness="0"
                        Background="Transparent"
                        IsTabStop="False"
                        Style="{DynamicResource ResourceKey=DefaultButton}">
                    <Image Source="/SFW;component/Icons/admin.ico"/>
                    <Button.Visibility>
                        <MultiBinding Converter="{StaticResource BoolToVisConverter}" ConverterParameter="1|1">
                            <Binding Path="(main:CurrentUser.IsQuality)"/>
                            <Binding Path="(main:CurrentUser.IsManager)"/>
                        </MultiBinding>
                    </Button.Visibility>
                </Button>

                <ComboBox x:Name="FormTypeFilter"
                          ItemsSource="{Binding TypeDictionary}"
                          SelectedValue="{Binding SelectedTypeFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          DisplayMemberPath="Key"
                          FontSize="18"
                          FontWeight="Bold"
                          Background="LightGray"
                          Width="Auto"
                          MinWidth="150"
                          Margin="5"
                          Style="{DynamicResource OptionalComboBox}"/>

                <Button Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding NewFormICommand}"
                        Visibility="{Binding Path=(main:CurrentUser.IsQuality), Converter={StaticResource BoolToVisConverter}}"
                        Margin="10,0,0,0">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/SFW;component/Icons/Add.ico" />
                        </StackPanel>
                    </Button.Content>
                </Button>

            </StackPanel>

        </Grid>

        <!--#endregion-->

        <!--#region Grid.Row 1 Notice Data-->

        <DataGrid x:Name="NcrNotice"
                  Grid.Row="1"
                  ItemsSource="{Binding CollectionView}"
                  IsSynchronizedWithCurrentItem="True"
                  HorizontalAlignment="Left"
                  HeadersVisibility="None"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                  ScrollViewer.CanContentScroll="True"
                  Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}, ConverterParameter=i}">

            <DataGrid.Columns>
                <DataGridTemplateColumn x:Name="dataGridTemplateColumn">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical">
                                <Grid Width="803">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding NcrId}" FontSize="24" VerticalAlignment="Center" FontWeight="Bold"/>
                                        <TextBlock Text="Revision:" Margin="20,0,0,0" VerticalAlignment="Center" TextDecorations="Underline"/>
                                        <TextBlock Text="{Binding NcrRevisionId}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                        <TextBlock Text="{Binding RevisionDateTime, StringFormat=d}" VerticalAlignment="Center" Margin="30,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding PartId}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ProductDescription}" Margin="10,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ScrapCost, StringFormat=C}" Margin="30,0,10,0" VerticalAlignment="Center"/>
                                        <Button Command="{StaticResource PartSearchCommand}"
                                                Margin="0,0,10,0"
                                                Height="30"
                                                IsTabStop="False"
                                                Style="{DynamicResource ResourceKey=DefaultButton}">
                                            <Image Source="/SFW;component/Icons/PartSearch.ico"/>
                                            <Button.CommandParameter>
                                                <MultiBinding Converter="{StaticResource PartSearchConverter}">
                                                    <Binding Source="NCR"/>
                                                    <Binding Path="PartId"/>
                                                </MultiBinding>
                                            </Button.CommandParameter>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="Work Order:" Margin="5,0,0,0" TextDecorations="Underline"/>
                                        <TextBlock Text="{Binding WorkOrderId}" Margin="5,0,0,0"/>
                                        <TextBlock Text="Found:" Margin="20,0,0,0" TextDecorations="Underline"/>
                                        <TextBlock Text="{Binding FoundWorkCenterName}" Margin="5,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DispositionDescription}" Margin="0,0,5,0"/>
                                    </StackPanel>
                                </Grid>
                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBlock Grid.Column="0" Text="{Binding ReasonDescription}" HorizontalAlignment="Left" Margin="5,0,0,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding TypeDescription}" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding SubTypeDescription}" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>

            <DataGrid.RowStyle>
                <Style TargetType="{x:Type DataGridRow}">
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="18"/>

                    <Style.Triggers>
                        <!--Open NCRs-->
                        <DataTrigger Binding="{Binding FormStatus}" Value="Open">
                            <Setter Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                        <GradientStop Color="White" Offset="0"/>
                                        <GradientStop Color="#FFF3321F" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <!--Closed NCRs-->
                        <DataTrigger Binding="{Binding FormStatus}" Value="Closed">
                            <Setter Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                        <GradientStop Color="White" Offset="0"/>
                                        <GradientStop Color="#FF29D129" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <!--Pending NCRs-->
                        <DataTrigger Binding="{Binding FormStatus}" Value="Pending">
                            <Setter Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                        <GradientStop Color="White" Offset="0"/>
                                        <GradientStop Color="Orange" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>

                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.CellStyle>
                <Style TargetType="{x:Type DataGridCell}">
                    <Style.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/>
                    </Style.Resources>
                    <Style.Triggers>

                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsSelected}" Value="True"/>
                                <Condition Binding="{Binding FormStatus}" Value="Open"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Background" Value="LightCoral"/>
                            <Setter Property="Foreground" Value="Black"/>
                            <Setter Property="BorderBrush" Value="RoyalBlue" />
                        </MultiDataTrigger>

                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsSelected}" Value="True"/>
                                <Condition Binding="{Binding FormStatus}" Value="Closed"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Background" Value="DarkSeaGreen"/>
                            <Setter Property="Foreground" Value="Black"/>
                            <Setter Property="BorderBrush" Value="RoyalBlue" />
                        </MultiDataTrigger>

                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsSelected}" Value="True"/>
                                <Condition Binding="{Binding FormStatus}" Value="Pending"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Background" Value="Bisque"/>
                            <Setter Property="Foreground" Value="Black"/>
                            <Setter Property="BorderBrush" Value="RoyalBlue" />
                        </MultiDataTrigger>

                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>

            <DataGrid.GroupStyle>
                <GroupStyle>
                    <GroupStyle.ContainerStyle>
                        <Style TargetType="{x:Type GroupItem}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type GroupItem}">
                                        <Expander BorderBrush="Black" Background="#FF135185" Foreground="Black" BorderThickness="1">
                                            <i:Interaction.Behaviors>
                                                <bhvr:ExpanderState GroupName="{Binding Name}"/>
                                            </i:Interaction.Behaviors>
                                            <Expander.Header>
                                                <Grid Width="760">

                                                    <TextBlock x:Name="ExpanderName" HorizontalAlignment="Left" FontWeight="Bold" Foreground="WhiteSmoke" Margin="10,0,0,0" FontSize="20" Text="{Binding Name, StringFormat=d}"/>
                                                    <TextBlock x:Name="ItemCount" HorizontalAlignment="Right" FontWeight="Bold" Foreground="WhiteSmoke" FontSize="20" Text="{Binding ItemCount}"/>

                                                </Grid>
                                            </Expander.Header>
                                            <Expander.Style>
                                                <Style TargetType="{x:Type Expander}">
                                                    <Setter Property="IsExpanded" Value="True"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=ExpanderName}" Value="Today">
                                                            <Setter Property="IsExpanded" Value="True"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Expander.Style>
                                            <ItemsPresenter/>
                                        </Expander>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.ContainerStyle>
                </GroupStyle>
            </DataGrid.GroupStyle>

        </DataGrid>

        <!--#endregion-->

    </Grid>
</UserControl>
