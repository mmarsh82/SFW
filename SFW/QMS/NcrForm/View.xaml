<UserControl x:Class="SFW.QMS.NcrForm.View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cmd="clr-namespace:SFW.Commands"
             xmlns:cvtr="clr-namespace:SFW.Converters"
             xmlns:main="clr-namespace:SFW"
             xmlns:local="clr-namespace:SFW.QMS.NcrForm"
             x:Name="NcrFormUC"
             AllowDrop="True"
             DragDrop.Drop="Photo_Drop"
             DragDrop.DragOver="Photo_DragOver"
             DragLeave="Photo_DragLeave">

    <ScrollViewer x:Name="MainScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,0,0,20" VerticalAlignment="Top">
        <Grid>

            <!--#region Resources -->

            <Grid.Resources>
                <cvtr:StringToVisibility x:Key="StringToVisConverter"/>
                <cvtr:IntToVisibility x:Key="IntToVisConverter"/>
                <cvtr:CountToVisibility x:Key="CountToVisConverter"/>
                <cvtr:SkuMasterPrint x:Key="PartSearchConverter"/>
                <cvtr:BoolToVisibility x:Key="BoolToVisConverter"/>
                <cvtr:DateToVisibility x:Key="DateToVisConverter" />
                <cvtr:ValueToHeight x:Key="ValueToHeightConverter"/>
                <cvtr:MultiValueParameter x:Key="MultiValConverter"/>
                <cvtr:NegativeIntToBool x:Key="NegIntToBoolConverter" />
                <cvtr:StatusToColor x:Key="StatusToColorConverter"/>
                <cvtr:StringToImageSource x:Key="StringToImageConverter"/>
                <cmd:ViewLoad x:Key="ViewLoadCommand" />
                <cmd:PartSearch x:Key="PartSearchICommand"/>
                <cmd:AddPhoto x:Key="AddPhoto"/>
            </Grid.Resources>

            <!--#endregion-->

            <TextBlock x:Name="AttachPhotoText"
                       Text="Attach Photo"
                       FontSize="56"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Visibility="Collapsed"
                       VerticalAlignment="Center">
                <TextBlock.RenderTransform>
                    <RotateTransform Angle="-35" CenterY="90" CenterX="180"/>
                </TextBlock.RenderTransform>
            </TextBlock>

            <TextBlock Text="Select a NCR"
                   FontSize="32"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center">
                <TextBlock.Visibility>
                    <MultiBinding Converter="{StaticResource IntToVisConverter}" ConverterParameter="NcrHeader">
                        <Binding Path="NcrObject.NcrId"/>
                        <Binding Path="IsNewNcr"/>
                    </MultiBinding>
                </TextBlock.Visibility>
            </TextBlock>

            <Grid x:Name="MainGrid"
                  Margin="10,0,10,0">
                <Grid.Visibility>
                    <MultiBinding Converter="{StaticResource IntToVisConverter}" ConverterParameter="NcrDetail">
                        <Binding Path="NcrObject.NcrId"/>
                        <Binding Path="IsNewNcr"/>
                    </MultiBinding>
                </Grid.Visibility>

                <Grid.RowDefinitions>
                    <RowDefinition x:Name="Row0" Height="40"/>
                    <RowDefinition x:Name="Row1" Height="50"/>
                    <RowDefinition x:Name="Row2" Height="30"/>
                    <RowDefinition x:Name="Row3" Height="10"/>
                    <RowDefinition x:Name="Row4" Height="30"/>
                    <RowDefinition x:Name="Row5" Height="10"/>
                    <RowDefinition x:Name="Row6" Height="30"/>
                    <RowDefinition x:Name="Row7" Height="10"/>
                    <RowDefinition x:Name="Row8" Height="30"/>
                    <RowDefinition x:Name="Row9" Height="10"/>
                    <RowDefinition x:Name="Row10" Height="30"/>
                    <RowDefinition x:Name="Row11" Height="10"/>
                    <RowDefinition x:Name="Row12" Height="30" />
                    <RowDefinition x:Name="Row13" Height="10"/>
                    <RowDefinition x:Name="Row14" Height="*"/>
                    <RowDefinition x:Name="Row15" Height="10"/>
                    <RowDefinition x:Name="Row16" Height="*"/>
                </Grid.RowDefinitions>

                <!--#region Grid.Row 0  Command Array-->

                <StackPanel Grid.Row="0"
                            Orientation="Horizontal">
                    
                    <Button Content="{Binding ActionType}"
                            FontSize="16"
                            Visibility="{Binding Path=(main:CurrentUser.IsQuality), Converter={StaticResource BoolToVisConverter}}"
                            Command="{Binding ActionICommand}"
                            Style="{DynamicResource MenuButtonStyle}" />

                    <Button Content="Add Link"
                            FontSize="16"
                            Command="{StaticResource ViewLoadCommand}"
                            Style="{DynamicResource MenuButtonStyle}">
                        <Button.Visibility>
                            <MultiBinding Converter="{StaticResource BoolToVisConverter}">
                                <Binding Path="(main:CurrentUser.IsQuality)"/>
                                <Binding Path="NcrObject.NcrId"/>
                            </MultiBinding>
                        </Button.Visibility>
                    </Button>

                    <Button Content="Add Photo"
                            FontSize="16"
                            Command="{StaticResource AddPhoto}"
                            CommandParameter="{Binding DataContext, ElementName=NcrFormUC}"
                            Style="{DynamicResource MenuButtonStyle}">
                        <Button.Visibility>
                            <MultiBinding Converter="{StaticResource BoolToVisConverter}">
                                <Binding Path="(main:CurrentUser.IsQuality)"/>
                                <Binding Path="NcrObject.NcrId"/>
                            </MultiBinding>
                        </Button.Visibility>
                    </Button>

                    <Button Content="Cancel"
                            FontSize="16"
                            Command="{Binding CancelICommand}"
                            Style="{DynamicResource MenuButtonStyle}">
                        <Button.Visibility>
                            <MultiBinding Converter="{StaticResource BoolToVisConverter}" ConverterParameter="NCR">
                                <Binding Source="Button"/>
                                <Binding Path="FromSchedule"/>
                                <Binding Path="IsNewNcr"/>
                            </MultiBinding>
                        </Button.Visibility>
                    </Button>

                    <Menu Style="{DynamicResource ModernMenu}"
                          Visibility="{Binding NcrObject.RevisionList.Count, Converter={StaticResource CountToVisConverter}, ConverterParameter=ncr}">
                        <MenuItem Header="   Revisions"
                                  ItemsSource="{Binding NcrObject.RevisionList, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  DisplayMemberPath="RevisionId"
                                  FontSize="16"
                                  Width="110"
                                  Height="39"
                                  Style="{DynamicResource ModernMenuItem}">
                            <MenuItem.ItemContainerStyle>
                                <Style TargetType="MenuItem">
                                    <Style.Resources>
                                        <cvtr:SelectedRevision x:Key="SelectedRevConverter"/>
                                    </Style.Resources>
                                    <Setter Property="Command"
                                            Value="{Binding ChangeRevICommand}" />
                                    <Setter Property="CommandParameter"
                                            Value="{Binding}" />
                                    <Setter Property="Foreground"
                                            Value="Black"/>
                                    <Setter Property="IsChecked"
                                            Value="{Binding Current, Converter={StaticResource SelectedRevConverter}}"/>
                                </Style>
                            </MenuItem.ItemContainerStyle>
                        </MenuItem>
                    </Menu>

                    <Button Content="Void"
                            FontSize="16"
                            Command="{Binding VoidICommand}"
                            Style="{DynamicResource MenuButtonStyle}">
                        <Button.Visibility>
                            <MultiBinding Converter="{StaticResource BoolToVisConverter}" ConverterParameter="NCR">
                                <Binding Source="Void"/>
                                <Binding Path="IsNewNcr"/>
                                <Binding Path="(main:CurrentUser.IsQuality)"/>
                            </MultiBinding>
                        </Button.Visibility>
                    </Button>

                </StackPanel>

                <!--#endregion-->

                <!--#region Grid.Row 1  NCR Header-->

                <StackPanel Grid.Row="1" Orientation="Horizontal"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Visibility="{Binding IsNewNcr, Converter={StaticResource BoolToVisConverter}, ConverterParameter=i}">

                    <TextBlock Text="NCR Number:"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="#FF135185"
                               TextDecorations="Underline"/>

                    <TextBlock Text="{Binding NcrObject.NcrId}"
                               FontSize="32"
                               FontWeight="Bold"
                               Margin="10,0,0,0" />

                    <TextBlock Text="{Binding SelectedDisposition.Status}"
                               FontSize="20"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Foreground="{Binding SelectedDisposition.Status, Converter={StaticResource StatusToColorConverter}}"
                               Margin="70,0,0,0"/>

                </StackPanel>

                <TextBlock Grid.Row="1"
                           Text="{Binding NcrRevision.SubmitDateTime, StringFormat=MM-dd-yyyy HH:mm}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="0,0,50,0" />

                <!--#endregion-->

                <!--#region Grid.Row 2 NCR Submission Header-->

                <StackPanel Grid.Row="2"
                            Orientation="Horizontal">

                    <TextBlock Text="Submitter:"
                               FontSize="20"
                               FontWeight="Bold"
                               TextDecorations="UnderLine"
                               Foreground="#FF135185" />

                    <TextBlock Text="{Binding NcrRevision.Submitter.Name}"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="10,0,30,0" />

                    <TextBlock Text="Reporter:"
                               FontSize="20"
                               FontWeight="Bold"
                               TextDecorations="UnderLine"
                               Foreground="#FF135185"
                               Margin="30,0,0,0"/>

                    <TextBlock Text="{Binding NcrObject.Reporter.Name}"
                               FontSize="20"
                               FontWeight="Bold"
                               Visibility="{Binding IsNewNcr, Converter={StaticResource BoolToVisConverter}, ConverterParameter=i}"
                               Margin="10,0,0,0"/>

                    <ComboBox x:Name="ReporterName"
                              ItemsSource="{Binding CrewCollection, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              SelectedValue="{Binding NcrObject.Reporter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              DisplayMemberPath="Name"
                              FontSize="18"
                              FontWeight="Bold"
                              Background="LightGray"
                              IsEditable="True"
                              Width="Auto"
                              MinWidth="100"
                              Margin="5,0,0,0"
                              Visibility="{Binding IsNewNcr, Converter={StaticResource BoolToVisConverter}}"
                              Style="{DynamicResource RequiredComboBox}"/>

                </StackPanel>

                <!--#endregion-->

                <!--#region Grid.Row 3 (Used as a spacer)-->
                <!--#endregion-->

                <!--#region Grid.Row 4 Work Order Data-->

                <StackPanel Grid.Row="4" Orientation="Horizontal">

                    <TextBlock Text="Work Order:"
                               FontSize="24"
                               FontWeight="Bold"
                               TextDecorations="UnderLine"
                               Foreground="#FF135185"/>

                    <TextBlock Text="{Binding NcrObject.OrderId}"
                               FontSize="24"
                               FontWeight="Bold"
                               Margin="10,0,0,0">
                        <TextBlock.Visibility>
                            <MultiBinding Converter="{StaticResource BoolToVisConverter}" ConverterParameter="NCR">
                                <Binding Source="Block"/>
                                <Binding Path="FromSchedule"/>
                                <Binding Path="IsNewNcr"/>
                            </MultiBinding>
                        </TextBlock.Visibility>
                    </TextBlock>

                    <TextBox x:Name="OrderId"
                             Text="{Binding NcrObject.OrderId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="18"
                             FontWeight="Bold"
                             Background="LightGray"
                             Width="150"
                             Margin="10,0,0,0"
                             MaxLength="7"
                             TabIndex="0"
                             Style="{DynamicResource RequiredTextBox}">
                        <TextBox.Visibility>
                            <MultiBinding Converter="{StaticResource BoolToVisConverter}" ConverterParameter="NCR">
                                <Binding Source="Box"/>
                                <Binding Path="FromSchedule"/>
                                <Binding Path="IsNewNcr"/>
                            </MultiBinding>
                        </TextBox.Visibility>
                    </TextBox>

                    <TextBlock Text="Operation:"
                               FontSize="24"
                               FontWeight="Bold"
                               Margin="50,0,0,0"
                               TextDecorations="Underline"
                               Foreground="#FF135185"/>

                    <TextBlock Text="{Binding NcrObject.OrderSeqId}"
                               FontSize="24"
                               FontWeight="Bold"
                               Margin="10,0,0,0">
                        <TextBlock.Visibility>
                            <MultiBinding Converter="{StaticResource BoolToVisConverter}" ConverterParameter="NCR">
                                <Binding Source="Block"/>
                                <Binding Path="FromSchedule"/>
                                <Binding Path="IsNewNcr"/>
                            </MultiBinding>
                        </TextBlock.Visibility>
                    </TextBlock>

                    <TextBox x:Name="OrderSeqId"
                             Text="{Binding NcrObject.OrderSeqId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="18"
                             Margin="10,0,0,0"
                             FontWeight="Bold"
                             Background="LightGray"
                             Width="50"
                             MaxLength="2"
                             TabIndex="1"
                             Style="{DynamicResource RequiredTextBox}">
                        <TextBox.Visibility>
                            <MultiBinding Converter="{StaticResource BoolToVisConverter}" ConverterParameter="NCR">
                                <Binding Source="Box"/>
                                <Binding Path="FromSchedule"/>
                                <Binding Path="IsNewNcr"/>
                            </MultiBinding>
                        </TextBox.Visibility>
                    </TextBox>

                </StackPanel>

                <!--#endregion-->

                <!--#region Grid.Row 5 (Used as a spacer)-->
                <!--#endregion-->

                <!--#region Grid.Row 6  Part Data-->

                <StackPanel Grid.Row="6" Orientation="Horizontal"
                            Visibility="{Binding NcrObject.IsValidOrder, Converter={StaticResource BoolToVisConverter}}">

                    <TextBlock Text="Part:"
                               FontSize="24"
                               FontWeight="Bold"
                               TextDecorations="UnderLine"
                               Foreground="#FF135185"/>

                    <TextBlock Text="{Binding NcrObject.Part.SkuNumber}"
                               FontSize="24"
                               FontWeight="Bold"
                               Visibility="{Binding IsNewNcr, Converter={StaticResource BoolToVisConverter}, ConverterParameter=i}"
                               Margin="10,0,0,0"/>

                    <ComboBox x:Name="ProductCollection"
                              ItemsSource="{Binding NcrObject.PartCollection, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              SelectedValue="{Binding NcrObject.Part, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              DisplayMemberPath="SkuNumber"
                              FontSize="18"
                              FontWeight="Bold"
                              Background="LightGray"
                              Width="150"
                              TabIndex="2"
                              Margin="5,0,0,0"
                              Visibility="{Binding IsNewNcr, Converter={StaticResource BoolToVisConverter}}"
                              Style="{DynamicResource RequiredComboBox}"/>

                    <TextBlock Text="{Binding NcrObject.Part.SkuDescription}"
                               FontSize="24"
                               FontWeight="Bold"
                               Visibility="Visible"
                               Margin="10,0,0,0" />

                </StackPanel>

                <!--#endregion-->

                <!--#region Grid.Row 7  (Used as a spacer)-->
                <!--#endregion-->

                <!--#region Grid.Row 8 Defect Information-->

                <StackPanel Grid.Row="8" Orientation="Horizontal"
                            Visibility="{Binding NcrObject.IsValidOrder, Converter={StaticResource BoolToVisConverter}}">

                    <TextBlock Text="Reason:"
                               FontSize="24"
                               FontWeight="Bold"
                               TextDecorations="UnderLine"
                               Foreground="#FF135185"/>

                    <TextBlock Text="{Binding SelectedReason.Description}"
                               Visibility="{Binding Path=(main:CurrentUser.IsQuality), Converter={StaticResource BoolToVisConverter}, ConverterParameter=i}"
                               FontSize="22"
                               FontWeight="Bold"
                               Margin="10,0,0,0" />

                    <ComboBox x:Name="DefectReason"
                              ItemsSource="{Binding NcrReasonCollection, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              SelectedValue="{Binding SelectedReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Visibility="{Binding Path=(main:CurrentUser.IsQuality), Converter={StaticResource BoolToVisConverter}}"
                              DisplayMemberPath="Description"
                              FontSize="18"
                              FontWeight="Bold"
                              Background="LightGray"
                              Width="Auto"
                              MinWidth="100"
                              TabIndex="3"
                              Margin="5,0,0,0"
                              Style="{DynamicResource RequiredComboBox}"/>

                    <TextBlock Text="Type:"
                               FontSize="24"
                               FontWeight="Bold"
                               Margin="50,0,0,0"
                               TextDecorations="Underline"
                               Foreground="#FF135185"/>

                    <TextBlock Text="{Binding SelectedType.Description}"
                               Visibility="{Binding Path=(main:CurrentUser.IsQuality), Converter={StaticResource BoolToVisConverter}, ConverterParameter=i}"
                               FontSize="22"
                               FontWeight="Bold"
                               Margin="10,0,0,0" />

                    <ComboBox x:Name="DefectType"
                              ItemsSource="{Binding NcrTypeCollection, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              SelectedValue="{Binding SelectedType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Visibility="{Binding Path=(main:CurrentUser.IsQuality), Converter={StaticResource BoolToVisConverter}}"
                              DisplayMemberPath="Description"
                              FontSize="18"
                              FontWeight="Bold"
                              Background="LightGray"
                              Width="Auto"
                              IsEditable="True"
                              MinWidth="100"
                              TabIndex="4"
                              Margin="5,0,0,0"
                              Style="{DynamicResource RequiredComboBox}"/>

                </StackPanel>

                <!--#endregion-->

                <!--#region Grid.Row 9  (Used as a spacer)-->
                <!--#endregion-->

                <!--#region Grid.Row 10 Machine Information-->

                <StackPanel Grid.Row="10" Orientation="Horizontal"
                            Visibility="{Binding NcrObject.IsValidOrder, Converter={StaticResource BoolToVisConverter}}">

                    <TextBlock Text="Found:"
                               FontSize="24"
                               FontWeight="Bold"
                               TextDecorations="UnderLine"
                               Foreground="#FF135185"/>

                    <TextBlock Text="{Binding NcrObject.FoundWorkCenter.MachineName}"
                               FontSize="20"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               FontWeight="Bold"/>

                    <CheckBox x:Name="IsEscape"
                              IsChecked="{Binding NcrRevision.IsEscape}"
                              FontSize="24"
                              Margin="30,0,0,0"
                              Foreground="#FF135185"
                              IsEnabled="{Binding Path=(main:CurrentUser.IsQuality)}"
                              Style="{DynamicResource SliderCheckBox}">
                        <CheckBox.Content>
                            <TextBlock Text="Escape:"
                                       TextDecorations="Underline"/>
                        </CheckBox.Content>
                    </CheckBox>

                    <TextBlock Text="Origin:"
                               FontSize="24"
                               FontWeight="Bold"
                               Margin="30,0,0,0"
                               TextDecorations="Underline"
                               Visibility="{Binding IsChecked, ElementName=IsEscape, Converter={StaticResource BoolToVisConverter}}"
                               Foreground="#FF135185"/>

                    <TextBlock Text="{Binding SelectedOriginMachine.MachineName}"
                               FontSize="20"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Visibility="{Binding Path=(main:CurrentUser.IsQuality), Converter={StaticResource BoolToVisConverter}}"
                               FontWeight="Bold"/>

                    <ComboBox x:Name="OriginMachine"
                              ItemsSource="{Binding MachineCollection, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              SelectedValue="{Binding SelectedOriginMachine, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              DisplayMemberPath="MachineName"
                              FontSize="18"
                              FontWeight="Bold"
                              Background="LightGray"
                              IsEditable="True"
                              Width="150"
                              TabIndex="5"
                              Margin="5,0,0,0"
                              Style="{DynamicResource RequiredComboBox}">
                        <ComboBox.Visibility>
                            <MultiBinding Converter="{StaticResource BoolToVisConverter}">
                                <Binding Path="IsChecked" ElementName="IsEscape"/>
                                <Binding Path="(main:CurrentUser.IsQuality)"/>
                            </MultiBinding>
                        </ComboBox.Visibility>
                    </ComboBox>

                </StackPanel>

                <!--#endregion-->

                <!--#region Grid.Row 11  (Used as a spacer)-->
                <!--#endregion-->

                <!--#region Grid.Row 12 Loss Information-->

                <StackPanel Grid.Row="12" Orientation="Horizontal"
                            Visibility="{Binding NcrObject.IsValidOrder, Converter={StaticResource BoolToVisConverter}}">

                    <TextBlock Text="Potential Loss:"
                               FontSize="24"
                               FontWeight="Bold"
                               TextDecorations="UnderLine"
                               Foreground="#FF135185"/>

                    <TextBlock Text="{Binding ViewPotentialLoss}"
                               FontSize="20"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               FontWeight="Bold"
                               Visibility="{Binding Path=(main:CurrentUser.IsQuality), Converter={StaticResource BoolToVisConverter}, ConverterParameter=i}"/>

                    <TextBox x:Name="PotentialLoss"
                             Text="{Binding ViewPotentialLoss, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="20"
                             FontWeight="Bold"
                             Background="LightGray"
                             Width="75"
                             VerticalAlignment="Center"
                             MaxLength="10"
                             TabIndex="6"
                             Margin="5,0,0,0"
                             Visibility="{Binding Path=(main:CurrentUser.IsQuality), Converter={StaticResource BoolToVisConverter}}"
                             Style="{DynamicResource RequiredTextBox}" />

                    <TextBlock Text="{Binding NcrObject.Part.Uom}"
                               FontSize="20"
                               VerticalAlignment="Center"
                               Margin="5,0,0,0"
                               Foreground="#FF135185"/>

                    <TextBlock Text="{Binding NcrRevision.PotentialValue, StringFormat=c}"
                               FontSize="20"
                               VerticalAlignment="Center"
                               Visibility="{Binding NcrRevision.PotentialLoss, Converter={StaticResource IntToVisConverter}, ConverterParameter=n0}"
                               Margin="10,0,0,0"
                               Foreground="Crimson"/>

                    <TextBlock Text="Actual Loss:"
                               FontSize="24"
                               FontWeight="Bold"
                               Margin="30,0,0,0"
                               TextDecorations="Underline"
                               Visibility="{Binding NcrRevision.ActualLoss, Converter={StaticResource IntToVisConverter}, ConverterParameter=n0}"
                               Foreground="#FF135185"/>

                    <TextBlock Text="{Binding NcrRevision.ActualLoss}"
                               FontSize="20"
                               VerticalAlignment="Center"
                               Visibility="{Binding NcrRevision.ActualLoss, Converter={StaticResource IntToVisConverter}, ConverterParameter=n0}"
                               Foreground="Crimson"
                               Margin="10,0,0,0"/>

                    <TextBlock Text="{Binding NcrRevision.ActualCost, StringFormat=c}"
                               FontSize="20"
                               VerticalAlignment="Center"
                               Visibility="{Binding NcrRevision.ActualLoss, Converter={StaticResource IntToVisConverter}, ConverterParameter=n0}"
                               Foreground="Crimson"
                               Margin="10,0,0,0"/>

                    <TextBlock Text="Disposition:"
                               FontSize="24"
                               FontWeight="Bold"
                               Margin="30,0,0,0"
                               TextDecorations="Underline"
                               Foreground="#FF135185"/>

                    <TextBlock Text="{Binding SelectedDisposition.Description}"
                               FontSize="20"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               FontWeight="Bold"
                               Visibility="{Binding Path=(main:CurrentUser.IsQuality), Converter={StaticResource BoolToVisConverter}, ConverterParameter=i}"/>

                    <ComboBox x:Name="Disposition"
                              ItemsSource="{Binding DispositionCollection, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              SelectedValue="{Binding SelectedDisposition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              DisplayMemberPath="Description"
                              FontSize="18"
                              FontWeight="Bold"
                              Width="200"
                              TabIndex="7"
                              Margin="5,0,0,0"
                              Visibility="{Binding Path=(main:CurrentUser.IsQuality), Converter={StaticResource BoolToVisConverter}}"
                              Style="{DynamicResource RequiredComboBox}"/>

                </StackPanel>

                <!--#endregion-->

                <!--#region Grid.Row 13  (Used as a spacer)-->
                <!--#endregion-->

                <!--#region Grid.Row 14 NCR Notes-->

                <Grid Grid.Row="14"
                      Visibility="{Binding NcrObject.IsValidOrder, Converter={StaticResource BoolToVisConverter}}">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="600"/>
                        <ColumnDefinition Width="350"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Grid.Row="0"
                               Text="Notes:"
                               FontSize="24"
                               FontWeight="Bold"
                               TextDecorations="UnderLine"
                               Foreground="#FF135185"/>

                    <TextBox x:Name="NcrNotes"
                             Grid.Column="0" Grid.Row="1"
                             Text="{Binding NcrRevision.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             MinWidth="300"
                             MaxWidth="580"
                             MaxLength="1000"
                             IsEnabled="{Binding Path=(main:CurrentUser.IsQuality)}"
                             Background="LightGray"
                             HorizontalAlignment="Left"
                             FontSize="20"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             TabIndex="8"
                             SpellCheck.IsEnabled="True"
                             SpellCheck.SpellingReform="PreAndPostreform"
                             TextWrapping="WrapWithOverflow"
                             Margin="0,10,0,0"
                             Style="{StaticResource OptionalTextBox}"/>

                    <Rectangle Grid.Column="1" Grid.Row="0"
                               Fill="#FF135185"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch"
                               Visibility="{Binding NcrObject.Part.IsLotTrace, Converter={StaticResource BoolToVisConverter}}"/>

                    <TextBlock Grid.Column="1" Grid.Row="0"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Text="Lot Numbers"
                               FontWeight="Bold"
                               FontSize="20"
                               Foreground="WhiteSmoke"
                               Visibility="{Binding NcrObject.Part.IsLotTrace, Converter={StaticResource BoolToVisConverter}}"/>

                    <Button Grid.Column="1" Grid.Row="0"
                            Command="{Binding AddLotICommand}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,1,10,4"
                            Background="Transparent"
                            BorderThickness="0"
                            Style="{DynamicResource DefaultButton}">
                        <Button.Content>
                            <Image Source="/SFW;component/Icons/Add.ico" />
                        </Button.Content>
                        <Button.Visibility>
                            <MultiBinding Converter="{StaticResource BoolToVisConverter}">
                                <Binding Path="(main:CurrentUser.IsQuality)"/>
                                <Binding Path="NcrObject.Part.IsLotTrace"/>
                            </MultiBinding>
                        </Button.Visibility>
                    </Button>

                    <ItemsControl Name="LotNumbers"
                                  Grid.Column="1" Grid.Row="1"
                                  ItemsSource="{Binding Path=NcrObject.LotList}"
                                  Margin="10,0,0,0"
                                  FontSize="18"
                                  Cursor="Hand"
                                  Background="Transparent"
                                  Foreground="Black"
                                  Focusable="False"
                                  Visibility="{Binding NcrObject.Part.IsLotTrace, Converter={StaticResource BoolToVisConverter}}">

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel IsItemsHost="True"
                                                        Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

                                <StackPanel Orientation="Vertical">
                                    <StackPanel Orientation="Horizontal">

                                        <Image Source="/SFW;component/Icons/Warning.ico"
                                               Width="20"
                                               Height="20"
                                               Visibility="{Binding Validated, Converter={StaticResource BoolToVisConverter}, ConverterParameter=i}"/>

                                        <TextBlock Text="Lot Number:"
                                                   TextDecorations="Underline"
                                                   FontWeight="Bold"
                                                   Foreground="#FF135185"
                                                   Margin="5,0,0,0"/>

                                        <TextBox Text="{Binding LotNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="16"
                                                 Width="150"
                                                 CharacterCasing="Upper"
                                                 Margin="3"
                                                 Visibility="{Binding Path=(main:CurrentUser.IsQuality), Converter={StaticResource BoolToVisConverter}}"
                                                 Background="LightGray" />

                                        <TextBlock Text="{Binding LotNumber}"
                                                   VerticalAlignment="Center"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Visibility="{Binding Path=(main:CurrentUser.IsQuality), Converter={StaticResource BoolToVisConverter}, ConverterParameter=i}"
                                                   Margin="5,0,0,0"/>

                                        <Button Command="{Binding DataContext.RemoveLotICommand, ElementName=NcrFormUC}"
                                                CommandParameter="{Binding LotNumber}"
                                                Width="22"
                                                Height="22"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Margin="10,0 0 0"
                                                Visibility="{Binding Path=(main:CurrentUser.IsQuality), Converter={StaticResource BoolToVisConverter}}"
                                                Style="{DynamicResource DefaultButton}">
                                            <Button.Content>
                                                <Image Source="/SFW;component/Icons/Remove.ico" />
                                            </Button.Content>
                                        </Button>

                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                    <Image Grid.ColumnSpan="2" Grid.Row="2"
                           x:Name="DefectPhotos">
                        
                    </Image>
                    
                </Grid>

                <!--#endregion-->

                <!--#region Grid.Row 15  (Used as a spacer)-->
                <!--#endregion-->

                <!--#region Grid.Row 16  Defect Images-->

                <DataGrid x:Name="NcrPhotos"
                          Grid.Row="16"
                          ItemsSource="{Binding NcrObject.PhotoCollection, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          HorizontalAlignment="Left"
                          HeadersVisibility="None"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                          ScrollViewer.CanContentScroll="True">

                    <DataGrid.Columns>
                        <DataGridTemplateColumn x:Name="dataGridTemplateColumn">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="500"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <Image Grid.Column="0"
                                                   Source="{Binding}"
                                                   MaxHeight="500">
                                            </Image>
                                            <Button Grid.Column="1"
                                                    Command="{Binding DataContext.RemovePhotoICommand, ElementName=NcrFormUC}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Visibility="{Binding Path=(main:CurrentUser.IsQuality), Converter={StaticResource BoolToVisConverter}}"
                                                    Style="{DynamicResource ResourceKey=DefaultButton}">
                                                <Image Source="/SFW;component/Icons/Remove.ico"/>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>

                    <DataGrid.CellStyle>
                        <Style TargetType="{x:Type DataGridCell}">
                            <Style.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/>
                            </Style.Resources>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </DataGrid.CellStyle>

                </DataGrid>

                <!--#endregion-->

            </Grid>

        </Grid>
    </ScrollViewer>
</UserControl>
