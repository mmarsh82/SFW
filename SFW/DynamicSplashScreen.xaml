<Window x:Class="SFW.DynamicSplashScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SFW"
        Title="DynamicSplashScreen"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ShowInTaskbar="False"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        Background="Black">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="10"/>
        </Grid.RowDefinitions>
        <Image Grid.Row="0"
               x:Name="CompanyLogoImage"
               Margin="10"
               Source="/Images/ContiLogo.png"/>
        
        <TextBlock Grid.Row="1"
                   x:Name="UpdateMessage"
                   Text="{Binding Path=(local:App.SplashMessage)}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   FontSize="30"
                   Foreground="DeepSkyBlue" />

        <TextBlock Grid.Row="2"
                   x:Name="UpdateDetail"
                   Text="{Binding Path=(local:App.SplashDetail)}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   FontSize="20"
                   Foreground="Goldenrod" />
    </Grid>
</Window>
